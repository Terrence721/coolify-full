        "@inertiajs/react": "^3.6.1",
        "@tailwindcss/forms": "0.5.11",
        "@tailwindcss/typography": "0.5.20",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/xterm": "6.0.0",
        "laravel-echo": "^2.3.7",
        "playwright": "^1.61.1",
        "pusher-js": "^8.5.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    }
