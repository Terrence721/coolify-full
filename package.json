{
    "name": "coolify",
    "private": true,
    "type": "module",
    "scripts": {
        "clean:logs": "bash scripts/clean-logs.sh",
        "predev": "yarn clean:logs",
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "lint": "eslint resources/js",
        "format:check": "prettier --check resources/js",
        "validate:html": "html-validate storage/app/html-validate-snapshots/*.html"
