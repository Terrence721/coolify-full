# Coolify Configuration
APP_ENV=local
APP_NAME=Coolify
APP_ID=development
APP_KEY=
APP_URL=http://localhost
APP_PORT=8000
APP_DEBUG=true
SSH_MUX_ENABLED=true

# PostgreSQL Database Configuration
# DB_HOST is the coolify-db compose service name, not host.docker.internal - both containers
# share the same Docker network, so this resolves via reliable internal Docker DNS. Routing
# through host.docker.internal instead hairpins out through the Windows/WSL2 host-gateway NAT,
# which was found to intermittently fail ("server closed the connection unexpectedly") on long-
# running Docker Desktop/WSL2 setups. Matches MAIL_HOST below, which already used the service
# name for the same reason.
DB_DATABASE=coolify
DB_USERNAME=coolify
DB_PASSWORD=password
DB_HOST=coolify-db
DB_PORT=5432

# Mail (routed to the dev stack's Mailpit container - view sent mail at http://localhost:8025).
# Without this, MAIL_MAILER falls back to Laravel's "array" driver (config/mail.php), which
# silently discards every email instead of sending it - found via manual smoke-test QA when the
# profile email-change verification code never arrived anywhere.
MAIL_MAILER=smtp
MAIL_HOST=coolify-mail
MAIL_PORT=1025
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Read/write replicas (optional). Set DB_READ_HOST to enable the read/write split.
# Hosts may be comma-separated. Port/username/password fall back to DB_* when unset.
# DB_READ_HOST=replica1,replica2
# DB_READ_PORT=5432
# DB_READ_USERNAME=coolify
# DB_READ_PASSWORD=
# DB_WRITE_HOST=
# DB_WRITE_PORT=5432
# DB_WRITE_USERNAME=coolify
# DB_WRITE_PASSWORD=
# DB_STICKY=true

# Ray Configuration
# Set to true to enable Ray
RAY_ENABLED=false
# Set custom ray port
# RAY_PORT=

# Enable Laravel Telescope for debugging
TELESCOPE_ENABLED=false

# Enable Laravel Nightwatch monitoring
NIGHTWATCH_ENABLED=false
NIGHTWATCH_TOKEN=

# Selenium Driver URL for Dusk
DUSK_DRIVER_URL=http://selenium:4444

# Special Keys for Andras
# For cache purging
BUNNY_API_KEY=
# For asset uploads
BUNNY_STORAGE_API_KEY=
